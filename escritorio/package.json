{
  "name": "kinet-os-escritorio",
  "productName": "KINET OS",
  "version": "1.0.0",
  "description": "KINET OS para Windows, Mac y Linux (envoltorio de escritorio de https://kinetos.es)",
  "author": "KINET OS <soporte@kinetos.es>",
  "license": "UNLICENSED",
  "private": true,
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --publish never"
  },
  "devDependencies": {
    "electron": "^33.2.0",
    "electron-builder": "^25.1.8"
  },
  "build": {
    "appId": "es.kinetos.escritorio",
    "productName": "KINET OS",
    "copyright": "KINET OS",
    "directories": { "output": "dist", "buildResources": "build" },
    "files": ["main.js", "offline.html", "build/icon.png", "package.json"],
    "win": {
      "target": [{ "target": "nsis", "arch": ["x64"] }],
      "icon": "build/icon.png",
      "artifactName": "KINET-OS-Setup.${ext}"
    },
    "nsis": { "oneClick": false, "allowToChangeInstallationDirectory": true, "perMachine": false, "createDesktopShortcut": true, "shortcutName": "KINET OS" },
    "mac": {
      "target": [{ "target": "dmg", "arch": ["universal"] }],
      "icon": "build/icon.png",
      "category": "public.app-category.sports",
      "artifactName": "KINET-OS.${ext}"
    },
    "linux": {
      "target": ["AppImage"],
      "icon": "build/icon.png",
      "category": "Sports",
      "artifactName": "KINET-OS.${ext}"
    }
  }
}
